# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=
DISCORD_OWNER_IDS=

# Torii API
TORII_API_BASE_URL=https://lazer-api.shikkesora.com
TORII_WEB_BASE_URL=https://lazer.shikkesora.com
TORII_API_TOKEN=
TORII_OAUTH_CLIENT_ID=
TORII_OAUTH_CLIENT_SECRET=
TORII_OAUTH_USERNAME=
TORII_OAUTH_PASSWORD=
TORII_API_TIMEOUT_SECONDS=15

# Bot runtime
BOT_DATABASE_PATH=./data/torii_bot.sqlite3
BOT_LOG_LEVEL=INFO
DEFAULT_MODE=osu
MOD_ALERT_CHANNEL_ID=
MOD_ALERT_TOKEN=
MOD_ALERT_POLL_SECONDS=5
MOD_ALERT_MENTION_HERE=true

# Upstream-watch (polls ppy/osu master for breaking changes — currently
# tracks realm schema_version bumps). Channel falls back to
# MOD_ALERT_CHANNEL_ID if left empty. Interval default is 6 hours.
UPSTREAM_WATCH_CHANNEL_ID=
UPSTREAM_WATCH_INTERVAL_SECONDS=21600
UPSTREAM_WATCH_MENTION_HERE=false

# Economy
ECONOMY_DAILY_MIN=120
ECONOMY_DAILY_MAX=260
ECONOMY_WORK_MIN=30
ECONOMY_WORK_MAX=120
ECONOMY_WORK_COOLDOWN_MINUTES=60

# o!rdr render watch (videos de replays renderizados, opt-in del user)
# canal donde postear; si esta vacio cae al de mod-alerts
ORDR_WATCH_CHANNEL_ID=
ORDR_WATCH_POLL_SECONDS=30
ORDR_WATCH_CREATE_THREADS=true
